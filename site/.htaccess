# eli english: настройки для хостинга на Apache или LiteSpeed
# (Beget, Timeweb, REG.RU и большинство обычных хостингов)

AddDefaultCharset utf-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Всегда HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Адрес без www: www.site.ru -> site.ru
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Старые ссылки ?lang=pl ведут на польскую страницу
  RewriteCond %{QUERY_STRING} (^|&)lang=pl(&|$)
  RewriteRule ^$ /pl/? [L,R=301]

  # Без дублей: /index.html -> /, /pl/index.html -> /pl/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

  # /pl без слэша -> /pl/
  RewriteRule ^pl$ /pl/ [L,R=301]
</IfModule>

# Служебные файлы не открываются из браузера
<FilesMatch "^(config|config\.example|eli-config)\.php$">
  Require all denied
</FilesMatch>
# скрытые файлы (.htaccess, .git, .env и т.п.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# резервные копии, журналы, архивы, исходники инструментов
<FilesMatch "\.(bak|old|orig|save|swp|tmp|sql|log|ini|conf|sh|md|zip|tar|gz|7z|rar|mjs|json|lock)$">
  Require all denied
</FilesMatch>

# Сжатие: страница грузится быстрее
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Кэш в браузере. style.css и main.js подключены с меткой версии (?v=...),
# поэтому их можно кэшировать надолго: после правки метка меняется (node tools/build.mjs).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Защитные заголовки
<IfModule mod_headers.c>
  # Что странице разрешено загружать и откуда. Только свой сайт и шрифты Google.
  # Если подключите Яндекс Метрику или другой внешний сервис, его адрес нужно добавить сюда.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # Браузер ходит на сайт только по HTTPS (включается после настройки SSL на хостинге)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Сайт нельзя встроить в чужую страницу (защита от подмены кликов)
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Странице не нужны камера, микрофон, геолокация и платежи
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Не сообщать версию сервера и PHP
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
